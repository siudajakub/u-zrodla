[Unit]
Description=InvestWatch public profile observation and daily report
ConditionPathIsMountPoint=%h/projects

[Service]
Type=oneshot
WorkingDirectory=%h/projects/hacknation/uknf-investwatch
ExecStart=/bin/sh ops/user-systemd/run-watch.sh
UMask=0077
Nice=10
NoNewPrivileges=true
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=5min
